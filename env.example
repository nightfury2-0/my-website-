# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Application type: "Web application"
# Authorized JavaScript origins: http://localhost:3000 (and your real domain later)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Outgoing mail (used to email the user AND to notify admins) ---
# If using Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and put it below (NOT your real Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-character-app-password

# --- First admin ---
# This seeds data/admins.json the first time the server starts.
# After that, admins.json is the source of truth — manage admins at /admin.html
# (sign in there with an account that's already on the list) rather than editing
# this value again.
ADMIN_EMAIL=admin@example.com

# --- Server ---
PORT=3000
